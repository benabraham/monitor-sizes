{
  "name": "monitor-sizes",
  "version": "1.0.0",
  "private": true,
  "description": "Pixely a monitory: an offline PWA that compares displays by size, sharpness, viewing angle and OS scaling against the displays you already know.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import-sheet": "node scripts/import-sheet.js",
    "size": "node scripts/check-bundle-size.js",
    "check": "pnpm format:check && pnpm coverage && pnpm build && pnpm size"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "idb-keyval": "^6.3.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
